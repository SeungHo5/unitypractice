{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@components/*": ["components/*"],
      "@pages/*": ["pages/*"],
      "@assets/*": ["assets/*"],
      "@stores/*": ["stores/*"],
      "@navigation/*": ["navigation/*"]
    }
  },
  "include": [
    "src/**/*",
    "App.js",
    "index.js"
  ]
}
